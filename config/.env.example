# Jarvis-Muse — secrets (exemple)
# Copier vers .env et remplir. Le fichier .env réel est GITIGNORÉ : ne jamais le commiter.
# Toutes les variables sont facultatives au départ : le Jarvis local démarre
# sans clé, avec la voix locale et le minuteur. Les clés ne servent qu'aux
# services infonuagiques optionnels.

# LLM infonuagique — cerveau de la boucle vocale (étape 4).
# Groq : par défaut. Clé gratuite, sans carte : https://console.groq.com
# (API Keys). Le palier gratuit suffit pour la boucle ; ne rien confier
# de sensible par prudence (conditions vérifiées le 21 nov. 2026 : pas
# d'entraînement sur les données, pas de rétention par défaut, ZDR dispo).
# GROQ_API_KEY=

# Anthropic : alternative configurable (fournisseur_llm = "anthropic" dans
# config.toml). Claude Haiku par API, payant à l'usage (~0,25 $ / 1 M de
# tokens en entrée).
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Voix infonuagique (optionnel — la voix locale est le choix par défaut)
# ELEVENLABS_API_KEY=

# Recherche web (optionnel)
# TAVILY_API_KEY=

# Fuseau horaire (défaut : America/Toronto dans config.toml)
# JARVIS_TZ=America/Toronto
