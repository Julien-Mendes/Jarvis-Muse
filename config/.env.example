# Jarvis-Muse — secrets (exemple)
# Copier vers .env et remplir. Le fichier .env réel est GITIGNORÉ : ne jamais le commiter.
# Toutes les variables sont facultatives au départ : le Jarvis local démarre
# sans clé, avec la voix locale et le minuteur. Les clés ne servent qu'aux
# services infonuagiques optionnels.

# LLM infonuagique (optionnel — Carson / Muse est le cerveau par défaut)
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Voix infonuagique (optionnel — la voix locale est le choix par défaut)
# ELEVENLABS_API_KEY=

# Recherche web (optionnel)
# TAVILY_API_KEY=

# Fuseau horaire (défaut : America/Toronto dans config.toml)
# JARVIS_TZ=America/Toronto
